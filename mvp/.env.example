# Copy to .env and fill in. Never commit .env.
# Stripe publishable key. Use a TEST key (pk_test_...) while developing.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
# URL of the create-payment-intent function (see supabase/functions/server).
VITE_PAYMENT_INTENT_URL=https://YOUR-PROJECT.supabase.co/functions/v1/server/make-server-eacb9d52/create-payment-intent
